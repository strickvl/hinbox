domain: "{DOMAIN_NAME}"
description: "{DOMAIN_DESCRIPTION}"

# Data source configuration
data_sources:
  default_path: "data/{DOMAIN_NAME}/raw_sources/{DOMAIN_NAME}_articles.parquet"

# Output configuration  
output:
  directory: "data/{DOMAIN_NAME}/entities"

# Prompt variants by model. For a model whose name contains one of a
# family's parts, a prompt file named <prompt>.<family>.md (for example
# relevance.qwen.md) is used instead of <prompt>.md. Families are tried in
# order, then "local" (ollama/ models) or "cloud". Add a variant only when the
# eval shows it beats the default for that model (`just eval show --grid`).
prompt_families:
  qwen: [qwen]
  bolt: [bolt, nemotron]

# Legacy similarity threshold (superseded by dedup section below)
similarity_threshold: 0.75

# Deduplication configuration
dedup:
  similarity_thresholds:
    default: 0.75
    people: 0.82
    organizations: 0.78
    locations: 0.80
    events: 0.76
  lexical_blocking:
    enabled: true
    threshold: 60        # RapidFuzz score cutoff (0-100)
    max_candidates: 50   # max entities to run cosine similarity against
  # Name variant configuration for within-article dedup and merge blocking
  # Uncomment and customize for your domain:
  # name_variants:
  #   organizations:
  #     equivalence_groups:
  #       - ["Full Name", "Abbreviation", "Alternate Name"]

# Performance / concurrency configuration (uncomment to enable parallelism)
# performance:
#   concurrency:
#     extract_workers: 8        # parallel articles in extraction phase
#     extract_per_article: 4    # parallel entity types within article
#     llm_in_flight: 16         # max concurrent cloud LLM calls
#     ollama_in_flight: 2       # max concurrent Ollama calls (local mode)
#     merge_parallel_types: 4   # entity types merged at once within an article
#     grounding_workers: 8      # profiles grounding-checked at once
#   queue:
#     max_buffered_articles: 32  # backpressure limit for extraction -> merge

# Batching configuration (uncomment to tune embedding batch sizes)
# batching:
#   embed_batch_size: 64        # texts per embedding API call
#   embed_drain_timeout_ms: 100 # reserved for future async drain behaviour

# Caching configuration (uncomment to customize)
# cache:
#   enabled: true
#   embeddings:
#     lru_max_items: 4096
#   extraction:
#     enabled: true
#     subdir: "cache/extractions"
#     version: 1
#   match_check:
#     enabled: true
#     max_items: 8192
#   articles:
#     skip_if_unchanged: true

# Processing configuration

# Profiles
profiles:
  # Entity kinds whose profile is frozen after the first article: a later
  # article is linked to the entity but makes no profile update and adds no
  # text (src/engine/hub_profiles.py). Meant for hubs named in passing by most
  # articles. Keys are entity tables, values are their `type` values.
  # HINBOX_HUB_LINK_ONLY=off turns it off.
  # News outlets too: their profiles fill up with the stories they ran
  # ("McClatchy obtained a memo..."), which belong to the entities the
  # stories are about.
  link_only:
    locations: [country, region]
    organizations: [media]

  # Headings a long profile is reorganised under, once, when it passes
  # HINBOX_SECTION_REORGANISE_CHARS (8000) with HINBOX_SECTION_REORGANISE=on
  # (src/engine/section_reorganise.py). Keys are entity tables, then `type`
  # values (`event_type` for events) or `default`; each heading says what it
  # is for, which the model is shown. The model may add up to 2 headings for topics none
  # of these fit; code refuses one that shares a word with another heading.
  starter_headings:
    people:
      detainee:
        - Background: origin, life and activities before capture
        - Capture and CIA custody: arrest, rendition, CIA black sites and interrogation
        - Detention at Guantánamo: transfer to Guantánamo, camps, daily life and conditions there
        - Military commission or legal case: charges, hearings, rulings, plea talks, lawyers and habeas cases
        - Health and treatment: physical and mental health, medical care, hunger strikes, effects of torture
        - Release or transfer: review board decisions, release, repatriation and resettlement
      default:
        - Background: who they are and their career before the events covered
        - Role: the posts they hold or held and what they are responsible for
        - Cases and decisions: rulings, orders, actions and decisions they took, cases they worked on
        - Public statements: what they themselves said in public, in testimony or in interviews
    organizations:
      default:
        - Overview: what the organization is, its structure and its leaders
        - Role at Guantánamo: its part in running, guarding, staffing or overseeing detention
        - Actions and decisions: what it did or decided, such as orders, programs, policies and budgets
        - Legal challenges: lawsuits, court rulings and legal cases involving it
    events:
      default:
        - What happened: the event itself, when and where
        - People involved: who took part and what each did
        - Reactions: what officials, lawyers, groups and others said about it
        - Aftermath: what followed, such as rulings, inquiries and changes
    locations:
      default:
        - Overview: what and where the place is, and its history
        - Operations and conditions: how it is run and what it is like there (staff, detainee numbers, facilities)
        - Notable events: things that happened there, such as incidents, visits, protests and disasters
        - Legal and policy decisions: court rulings, laws and government decisions about the place

processing:
  # Enable relevance checking before extraction
  relevance_check: true
  
  # Batch size for processing articles
  batch_size: 5

# Embeddings configuration
embeddings:
  mode: cloud  # Options: auto, local, cloud, hybrid
  cloud:
    model: jina_ai/jina-embeddings-v3
    batch_size: 100
    max_retries: 3
    timeout: 30
  local:
    model: sentence-transformers/all-MiniLM-L6-v2
    batch_size: 32
    device: auto  # auto|cpu|cuda|mps